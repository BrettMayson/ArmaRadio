<?xml version='1.0' encoding='utf-8'?>
<Project name="Live Radio">
    <Package name="Interface">
        <Key ID="STR_Live_Radio_Interface_GlobalStations">
            <English>Global station list</English>
            <German>Globale Senderliste</German>
            <Spanish>Lista global de emisoras</Spanish>
        </Key>
        <Key ID="STR_Live_Radio_Interface_GlobalStationsTooltip">
            <English>Shared server/mission stations for all players. Format: [["Name","https://stream",false]]. The last value approves the station for Streamer Mode. Personal lists remain separate.</English>
            <German>Gemeinsame Server-/Missionssender für alle Spieler. Format: [["Name","https://stream",false]]. Der letzte Wert gibt den Sender für den Streamer Mode frei. Persönliche Listen bleiben separat.</German>
            <Spanish>Emisoras del servidor o misión para todos. Formato: [["Nombre","https://stream",false]]. El último valor aprueba la emisora para Streamer Mode. Las listas personales siguen separadas.</Spanish>
        </Key>
        <Key ID="STR_Live_Radio_Interface_GlobalStationsInvalid">
            <English>Invalid global station list. Use up to 100 entries: [["Name","https://stream",false]]. The last valid list is retained.</English>
            <German>Ungültige globale Senderliste. Maximal 100 Einträge: [["Name","https://stream",false]]. Die letzte gültige Liste bleibt erhalten.</German>
            <Spanish>Lista global inválida. Máximo 100 entradas: [["Nombre","https://stream",false]]. Se conserva la última lista válida.</Spanish>
        </Key>
